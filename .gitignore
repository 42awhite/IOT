# Vagrant generated files
.vagrant/
**/.vagrant/

# VS Code and editor history
.history/
**/.history/
.vscode/settings.json
.vscode/*.code-snippets

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# Local environment and secrets
.env
.env.*
!.env.example
**/token
**/token.*
*.key
*.pem
*.p12
*.pfx

# Terraform and local state, if used later
.terraform/
*.tfstate
*.tfstate.*

# Python cache, if used for helper scripts
__pycache__/
*.py[cod]

# Node dependencies, if used for helper tools
node_modules/
